# ── Production environment (copy to .env and fill in) ──────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
APP_BASE_URL=https://api.trueskill.com
WEB_VERIFY_URL=https://app.trueskill.com/verify-email

# Comma-separated allowed origins for CORS (admin web, etc.). Use exact origins in prod.
CORS_ORIGINS=https://admin.trueskill.com

# Behind a reverse proxy / load balancer (nginx, ELB)? keep this true.
TRUST_PROXY=true

# ── Database (MySQL) ───────────────────────────────────────
DB_DIALECT=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=trueskill_hrms
DB_USER=trueskill
DB_PASSWORD=__STRONG_DB_PASSWORD__
DB_SSL=false
# Max DB connections in the pool. Shared hosting caps concurrent connections —
# keep this low (3–5). Raise only if your DB plan allows more.
DB_POOL_MAX=5

# ── Secrets (generate fresh!) ──────────────────────────────
# openssl rand -hex 48
JWT_ACCESS_SECRET=__REPLACE__
JWT_REFRESH_SECRET=__REPLACE__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# openssl rand -hex 32   (32-byte key, 64 hex chars)
ENCRYPTION_KEY=__REPLACE_64_HEX__

# ── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=__SMTP_USER__
SMTP_PASSWORD=__SMTP_PASSWORD__
MAIL_FROM="TrueSkill HRMS <no-reply@trueskill.com>"

# ── Seed admin (run once via db:seed) ──────────────────────
SEED_ADMIN_EMAIL=admin@trueskill.com
SEED_ADMIN_PASSWORD=__STRONG_ADMIN_PASSWORD__
